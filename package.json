{
  "name": "kiranapro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:areas && npm run test:highlights && npm run test:app && npm run test:fulfilment && npm run test:catalog && npm run test:photos && npm run test:sample-stores && npm run test:editorial && npm run test:security && npm run test:performance && npm run test:ai-images && npm run test:batch-admin && npm run test:cache && vite build",
    "mobile:build": "vite build && npx cap sync android",
    "mobile:sync": "npx cap sync android",
    "mobile:open": "npx cap open android",
    "db:migrate": "node scripts/neon_migrate_and_seed.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:areas": "node --test tests/delivery-areas.test.mjs",
    "test:highlights": "node --test tests/neighborhood-highlights.test.mjs",
    "test:app": "node --test tests/app-providers.test.mjs",
    "test:fulfilment": "node --test tests/fulfilment.test.mjs",
    "test:catalog": "node --test tests/catalog-visuals.test.mjs",
    "test:photos": "node --test tests/photo-search.test.mjs",
    "test:sample-stores": "node --test tests/area-samples-guest.test.mjs",
    "test:editorial": "node --test tests/editorial-banners.test.mjs",
    "db:secure": "node scripts/apply_security_schema.mjs",
    "security:hash-admin": "node scripts/hash_admin_password.mjs",
    "test:security": "node --test tests/security-hardening.test.mjs",
    "test:performance": "node --test tests/performance-fast.test.mjs",
    "test:ai-images": "node --test tests/ai-catalog-images.test.mjs",
    "test:batch-admin": "node --test tests/batch-admin-images.test.mjs",
    "test:cache": "node --test tests/cache-refresh.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@neondatabase/serverless": "^1.2.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "@vercel/blob": "^2.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5"
  }
}
